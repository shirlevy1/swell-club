# Supabase → Project Settings → API
# העתיקו ל-.env.local (שלא נכנס ל-git). הוראות מלאות ב-SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# מצב הדגמה מכוון — נתוני דמה, בלי התחברות. גובר גם כשיש מפתחות
# למעלה, כדי שאפשר יהיה להראות את המוצר בלי למחוק אותם.
# NEXT_PUBLIC_SWELL_DEMO=1

# --- התראות דחיפה (משימה 5). להריץ: node scripts/generate-vapid.mjs ---
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:you@example.com
# PUSH_CRON_SECRET=
# מפתח־על של Supabase. **שרת בלבד** — בלי NEXT_PUBLIC_, ולעולם לא בקוד.
# נדרש רק לשליחת ההתראות, כי ל-cron אין משתמש מחובר.
# SUPABASE_SERVICE_ROLE_KEY=
